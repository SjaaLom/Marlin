@inherits LayoutComponentBase
@using Configurator.Client.Services
@inject AppState AppStateService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <input @bind="AppStateService.SearchTerm" @bind:event="oninput" placeholder="Search settings..." class="form-control w-auto me-2" style="max-width: 300px;" />
            <button class="btn btn-success" @onclick="AppStateService.RequestSave">Save Configuration</button>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
